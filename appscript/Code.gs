function admin_(u){if(u.role!=='admin')fail_('Akses pentadbir diperlukan.','FORBIDDEN');}
function scope_(u,group){return u.role==='admin'||u.role==='penyelaras'&&(u.scopes||[]).includes(group);}
function canRead_(u,r){return scope_(u,r.group)||r.ownerId===u.id||r.assignedTo===u.id;}
