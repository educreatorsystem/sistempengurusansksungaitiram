let _db;
function props_(){return PropertiesService.getScriptProperties();}
function db_(){return _db||(_db=SpreadsheetApp.openById(CONFIG.SHEET_ID));}
function uid_(){return Utilities.getUuid();}
function now_(){return new Date().toISOString();}
function text_(v,max){return String(v==null?'':v).trim().slice(0,max||4000);}
function fail_(message,code){const e=new Error(message);e.code=code||'VALIDATION';throw e;}
function table_(name){const t=db_().getSheetByName('SKAS2_'+name);if(!t)fail_('Jalankan setupSystem() versi 2 dahulu.','NOT_READY');return t;}
function rows_(name){const v=table_(name).getDataRange().getDisplayValues();if(v.length<2)return [];return v.slice(1).filter(r=>r[0]).map(r=>{const o={};v[0].forEach((h,i)=>{o[h]=JSON_KEYS.includes(h)?JSON.parse(r[i]||((h==='evidence')?'[]':'{}')):h==='notApplicable'?r[i]==='true':r[i];});return o;});}
function cell_(v){if(typeof v==='object'&&v!==null)return JSON.stringify(v);if(typeof v==='boolean')return v?'true':'false';const s=String(v==null?'':v);return /^[=+\-@]/.test(s)?"'"+s:s;}
function put_(name,o){const t=table_(name),ids=t.getLastRow()>1?t.getRange(2,1,t.getLastRow()-1,1).getDisplayValues().flat():[],i=ids.indexOf(o.id);t.getRange(i<0?t.getLastRow()+1:i+2,1,1,SCHEMA[name].length).setValues([SCHEMA[name].map(h=>cell_(o[h]))]);return o;}
