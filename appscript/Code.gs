function year_(v){v=text_(v,20);if(!/^20\d{2}$/.test(v))fail_('Tahun mesti antara 2000 dan 2099.');return v;}
function date_(v){if(!/^\d{4}-\d{2}-\d{2}$/.test(v)||isNaN(Date.parse(v))||new Date(v).toISOString().slice(0,10)!==v)fail_('Tarikh tidak sah.');return v;}
