function saveUser_(actor,d){admin_(actor);const users=allUsers_(),old=users.find(x=>x.id===d.id),username=text_(d.username,120).toLowerCase();if(!/^[a-z0-9._@-]{3,120}$/.test(username))fail_('Nama pengguna minimum 3 aksara; huruf kecil, nombor atau . _ @ - sahaja.');if(users.some(x=>x.username===username&&x.id!==(old&&old.id)))fail_('Nama pengguna sudah wujud.');if(!['admin','penyelaras','guru'].includes(d.role))fail_('Peranan tidak sah.');const next=Object.assign({},old||{id:uid_()},{username:username,name:text_(d.name,160),role:d.role,active:d.active!==false,scopes:Array.isArray(d.scopes)?d.scopes.filter(s=>INSTRUMEN.groups.some(g=>g.id===s)):[]});if(!next.name)fail_('Nama diperlukan.');if(next.role==='penyelaras'&&!next.scopes.length)fail_('Pilih skop penyelaras.');if(old&&old.id===actor.id&&(next.role!=='admin'||!next.active))fail_('Akaun sendiri tidak boleh dinyahaktif atau diturunkan peranan.');if(!old||d.password){setPassword_(next,String(d.password||''));next.forcePassword=true;}else if(old.role!==next.role||JSON.stringify(old.scopes)!==JSON.stringify(next.scopes)||old.active!==next.active)next.authVersion=uid_();saveUsers_([next]);log_(actor,'Kemaskini pengguna',next.id);return safeUser_(next);}
