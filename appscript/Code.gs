function allUsers_(){const p=props_().getProperties(),v=Object.keys(p).filter(k=>k.indexOf('SKAS2_USER_')===0).map(k=>JSON.parse(p[k]));return v.length?v:JSON.parse(p.SKAS_USERS||'[]');}
