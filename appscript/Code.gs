 if(!props_().getProperty('SKAS_PEPPER'))props_().setProperty('SKAS_PEPPER',uid_()+uid_());
 const users=allUsers_();if(users.length){saveUsers_(users);console.log('Akaun pengguna sedia ada dikekalkan. Gunakan kata laluan sedia ada.');}else{const pass='SKas!'+uid_().replace(/-/g,'').slice(0,15);saveUsers_([setPassword_({id:uid_(),username:'admin',name:'Pentadbir SK Sungai Tiram',role:'admin',scopes:INSTRUMEN.groups.map(g=>g.id),active:true,forcePassword:true},pass)]);console.log('Nama pengguna: admin | Kata laluan sementara: '+pass);}
