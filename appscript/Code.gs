 props_().setProperty('SKAS2_READY',CONFIG.VERSION);console.log('SK@S v2 tersedia: 70 item / 216 tindakan. Data SKAS_ versi lama dikekalkan. Deploy New version.');
 }finally{lock.releaseLock();}}
